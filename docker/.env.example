# Copy to .env (same folder) and edit for this machine. .env is not committed.
#   cp .env.example .env
#
# DAS_ROOT: the folder that holds MatSynth/. With MatSynth downloaded to D:\MatSynth
# (scripts in COMMANDS.txt), the parquet files are at D:\MatSynth\data\*.parquet and
# inside the containers at /data/MatSynth/data/*.parquet.
# Windows + Docker Desktop: forward slashes; the drive must be shared with Docker.
DAS_ROOT=D:/
